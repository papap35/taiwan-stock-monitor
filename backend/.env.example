# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# Anthropic API（到 console.anthropic.com 取得）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase（到 supabase.com 建立專案後取得）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# 允許的前端來源（Vercel 部署後填入實際網址）
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# 快取設定（秒）
CACHE_TTL_REALTIME=15
CACHE_TTL_DAILY=300

# Fugle API（選配，取得即時 Tick 資料）
FUGLE_API_KEY=

# 排程：交易時間抓取間隔（秒）
FETCH_INTERVAL_TRADING=15
FETCH_INTERVAL_IDLE=300
